# Base URL of the deployed wolso-api Worker (see worker/), no trailing slash.
# Example: https://wolso-api.yourname.workers.dev
VITE_API_URL=

# Your bot's @username (without the @), used to render the Telegram Login
# Widget on the admin sign-in screen. The bot's "Domain" must be set via
# @BotFather (/setdomain) to the origin this admin app is served from,
# or the widget will refuse to authenticate.
VITE_BOT_USERNAME=
